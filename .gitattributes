# Set default behaviour to automatically normalize line endings.
* text=auto

# =============================================================================
# Source code — LF
# =============================================================================

*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.jsx    text eol=lf
*.tsx    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.scss   text eol=lf

# =============================================================================
# Configuration files — LF
# =============================================================================

*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.toml   text eol=lf
*.xml    text eol=lf
*.lock   text eol=lf

# =============================================================================
# Documentation — LF
# =============================================================================

*.md     text eol=lf
*.rst    text eol=lf
*.txt    text eol=lf

# =============================================================================
# Git and editor configuration — LF
# =============================================================================

.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf

# =============================================================================
# Unix scripts and tools — LF
# =============================================================================

*.sh            text eol=lf
Dockerfile*     text eol=lf
docker-compose* text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf

# =============================================================================
# Windows-specific files — CRLF
# =============================================================================

*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
*.sln     text eol=crlf
*.vcxproj text eol=crlf
*.csproj  text eol=crlf

# =============================================================================
# Binary files — do not modify
# =============================================================================

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.whl  binary
*.egg  binary
