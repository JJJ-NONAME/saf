#### KEYCLOAK ENVS
# The Domain name that should be defined in your /etc/hosts and should point to the
# machine where the container are running
# With this config you will be able to access Keycloak at: ${PROTOCOL}://localhost:${PORT}/auth
DOMAIN_NAME=localhost
PORT=8443
PROTOCOL=https
DOCKER_RESTART_POLICY=unless-stopped
# HPS POSTGRES CONFIG
HPS_KC_POSTGRES_DB=keycloak
HPS_POSTGRES_USER=repadmin
HPS_POSTGRES_PASSWORD=repadmin
KC_CLIENT_SECRET=FRJILPV9NVKIAfcQqOtlkjo8inR5eVMWHyfNmlisLDw=
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=test
KC_REALM_ADMIN_USER=admin
KC_REALM_ADMIN_PASSWORD=admin
KC_ALLOW_REGISTER=true
### Action Tokens
KC_JOB_ACTION_TOKEN_REALMS=rep
KC_JOB_ACTION_TOKEN_AUTHORED_CLIENTS=rep-impersonation
KC_JOB_ACTION_TOKEN_MANAGEMENT_ROLE=manage-job-access-token
KC_JOB_ACTION_TOKEN_TTL=3600
OP_EMAIL_DOMAIN=ansys.com