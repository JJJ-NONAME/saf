# top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4

# JavaScript/TypeScript files
[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 2

# HTML/CSS files
[*.{html,css,scss}]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# TOML files
[*.toml]
indent_style = space
indent_size = 4

# JSON files
[*.json]
indent_style = space
indent_size = 2

# Markdown and rst files
[*.{md,rst}]
trim_trailing_whitespace = false
max_line_length = off

# Configuration files
[{.gitignore,.gitattributes}]
indent_style = space
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab

# Windows-specific files use CRLF
[*.{bat,cmd,ps1,sln,vcxproj,csproj}]
end_of_line = crlf

# Lock files (auto-generated, minimal formatting)
[{package-lock.json,poetry.lock}]
insert_final_newline = false
